{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contacts API",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "API для роботи з контактами: створення, оновлення, видалення та отримання списку.\n"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://nodejs-hw-mongodb-79wc.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Операції з контактами"
    },
    {
      "name": "Auth",
      "description": "Реєстрація та логін"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get list of contacts",
        "operationId": "getContacts",
        "description": "Отримати список усіх контактів з пагінацією та фільтрами",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "description": "Номер сторінки (для пагінації)",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "in": "query",
            "name": "perPage",
            "description": "Кількість контактів на сторінці",
            "schema": {
              "type": "integer"
            },
            "example": 10
          },
          {
            "in": "query",
            "name": "sortBy",
            "description": "Поле для сортування (наприклад: name, email, phone)",
            "schema": {
              "type": "string"
            },
            "example": "name"
          },
          {
            "in": "query",
            "name": "sortOrder",
            "description": "Порядок сортування",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "example": "asc"
          },
          {
            "in": "query",
            "name": "filter",
            "description": "Пошук за частиною імені або email",
            "schema": {
              "type": "string"
            },
            "example": "test"
          }
        ],
        "responses": {
          "200": {
            "description": "Список контактів успішно отримано!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contacts!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/contact"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "example": 1
                        },
                        "perPage": {
                          "type": "integer",
                          "example": 10
                        },
                        "totalItems": {
                          "type": "integer",
                          "example": 35
                        },
                        "totalPages": {
                          "type": "integer",
                          "example": 4
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": true
                        },
                        "hasPreviousPage": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "post": {
        "post": {
          "summary": "Create new contact",
          "description": "Створити новий контакт",
          "tags": [
            "Contacts"
          ],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "John Doe"
                    },
                    "email": {
                      "type": "string",
                      "example": "johndoe@example.com"
                    },
                    "phoneNumber": {
                      "type": "string",
                      "example": 380501234567
                    },
                    "contactType": {
                      "type": "string",
                      "example": "personal"
                    },
                    "photo": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Контакт успішно створено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 201
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully created a contact!"
                      },
                      "data": {
                        "$ref": "../../../components/schemas/contact.yaml"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../components/responses/401.yaml"
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "get": {
          "summary": "Get contact by id",
          "description": "Отримати інформацію про контакт за його ID",
          "tags": [
            "Contacts"
          ],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID контакту, який потрібно отримати"
            }
          ],
          "responses": {
            "200": {
              "description": "Контакт успішно знайдено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully found contact!"
                      },
                      "data": {
                        "$ref": "../../../../components/schemas/contact.yaml"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../../components/responses/404.yaml"
            }
          }
        }
      },
      "patch": {
        "patch": {
          "summary": "Update contact by id",
          "description": "Оновити інформацію про контакт за його ID",
          "tags": [
            "Contacts"
          ],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID контакту, який потрібно оновити"
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "John Doe"
                    },
                    "email": {
                      "type": "string",
                      "example": "johndoe@example.com"
                    },
                    "phoneNumber": {
                      "type": "string",
                      "example": 380501234567
                    },
                    "contactType": {
                      "type": "string",
                      "example": "personal"
                    },
                    "photo": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Контакт успішно оновлено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully updated contact!"
                      },
                      "data": {
                        "$ref": "../../../../components/schemas/contact.yaml"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../../components/responses/404.yaml"
            }
          }
        }
      },
      "delete": {
        "delete": {
          "summary": "Delete contact by id",
          "description": "Видалити контакт за його ID",
          "tags": [
            "Contacts"
          ],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID контакту, який потрібно видалити"
            }
          ],
          "responses": {
            "200": {
              "description": "Контакт успішно видалено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully deleted contact!"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../../components/responses/404.yaml"
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "68e128e40633e4c841a37c46"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "johndoe@example.com"
          },
          "phoneNumber": {
            "type": "string",
            "example": 380501234567
          },
          "isFavourite": {
            "type": "boolean",
            "example": false
          },
          "contactType": {
            "type": "string",
            "example": "personal"
          },
          "userId": {
            "type": "string",
            "example": "68e123fb2c08649de2af5735"
          },
          "photo": {
            "type": "string",
            "example": "https://res.cloudinary.com/dw3mqhimt/image/upload/v1759586532/contacts/hu2cnb6skxkp9bhmidxi.png"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-04T14:02:12.823Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-04T14:02:12.823Z"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
                "message": {
                  "type": "string",
                  "example": "UnauthorizedError"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Access token expired"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}