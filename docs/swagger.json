{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contacts API",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "API для роботи з контактами: створення, оновлення, видалення та отримання списку.\n"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://nodejs-hw-mongodb-79wc.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Операції з контактами"
    },
    {
      "name": "Auth",
      "description": "Реєстрація та логін"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "get": {
          "tags": [
            "Contacts"
          ],
          "summary": "Get list of contacts",
          "operationId": "getContacts",
          "description": "Отримати список усіх контактів з пагінацією та фільтрами",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "description": "Номер сторінки (для пагінації)",
              "schema": {
                "type": "integer"
              },
              "example": 1
            },
            {
              "in": "query",
              "name": "perPage",
              "description": "Кількість контактів на сторінці",
              "schema": {
                "type": "integer"
              },
              "example": 10
            },
            {
              "in": "query",
              "name": "sortBy",
              "description": "Поле для сортування (наприклад: name, email, phoneNumber)",
              "schema": {
                "type": "string"
              },
              "example": "name"
            },
            {
              "in": "query",
              "name": "sortOrder",
              "description": "Порядок сортування",
              "schema": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              },
              "example": "asc"
            },
            {
              "in": "query",
              "name": "filter",
              "description": "Пошук за частиною імені або email",
              "schema": {
                "type": "string"
              },
              "example": "test"
            }
          ],
          "responses": {
            "200": {
              "description": "Список контактів успішно отримано!",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully found contacts!"
                      },
                      "data": {
                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "array",
                            "items": {
                              "$ref": "../../components/schemas/contact.yaml"
                            }
                          },
                          "page": {
                            "type": "integer",
                            "example": 1
                          },
                          "perPage": {
                            "type": "integer",
                            "example": 10
                          },
                          "totalItems": {
                            "type": "integer",
                            "example": 35
                          },
                          "totalPages": {
                            "type": "integer",
                            "example": 4
                          },
                          "hasNextPage": {
                            "type": "boolean",
                            "example": true
                          },
                          "hasPreviousPage": {
                            "type": "boolean",
                            "example": false
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../components/responses/401.yaml"
            }
          }
        }
      },
      "post": {
        "post": {
          "tags": [
            "Contacts"
          ],
          "summary": "Create new contact",
          "description": "Створити новий контакт",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "John Doe"
                    },
                    "email": {
                      "type": "string",
                      "example": "johndoe@example.com"
                    },
                    "phoneNumber": {
                      "type": "string",
                      "example": 380501234567
                    },
                    "isFavourite": {
                      "type": "boolean",
                      "example": false
                    },
                    "contactType": {
                      "type": "string",
                      "example": "personal"
                    },
                    "photo": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Контакт успішно створено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 201
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully created a contact!"
                      },
                      "data": {
                        "$ref": "../../../components/schemas/contact.yaml"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../components/responses/401.yaml"
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "get": {
          "tags": [
            "Contacts"
          ],
          "summary": "Get contact by id",
          "description": "Отримати інформацію про контакт за його ID",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID контакту, який потрібно отримати"
            }
          ],
          "responses": {
            "200": {
              "description": "Контакт успішно знайдено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully found contact!"
                      },
                      "data": {
                        "$ref": "../../../../components/schemas/contact.yaml"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../../components/responses/404.yaml"
            }
          }
        }
      },
      "patch": {
        "patch": {
          "tags": [
            "Contacts"
          ],
          "summary": "Update contact by id",
          "description": "Оновити інформацію про контакт за його ID",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID контакту, який потрібно оновити"
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "John Doe"
                    },
                    "email": {
                      "type": "string",
                      "example": "johndoe@example.com"
                    },
                    "phoneNumber": {
                      "type": "string",
                      "example": 380501234567
                    },
                    "isFavourite": {
                      "type": "boolean",
                      "example": true
                    },
                    "contactType": {
                      "type": "string",
                      "example": "personal"
                    },
                    "photo": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Контакт успішно оновлено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully updated contact!"
                      },
                      "data": {
                        "$ref": "../../../../components/schemas/contact.yaml"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../../components/responses/404.yaml"
            }
          }
        }
      },
      "delete": {
        "delete": {
          "tags": [
            "Contacts"
          ],
          "summary": "Delete contact by id",
          "description": "Видалити контакт за його ID",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID контакту, який потрібно видалити"
            }
          ],
          "responses": {
            "200": {
              "description": "Контакт успішно видалено",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully deleted contact!"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../../components/responses/404.yaml"
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}